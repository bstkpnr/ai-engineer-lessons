# Backend'in adresi. Telefonda Expo Go ile denerken "localhost" çalışmaz;
# bilgisayarının yerel ağ IP adresini yaz (ör. http://192.168.1.42:3000).
EXPO_PUBLIC_API_URL=http://localhost:3000

# finans-rag servisinin adresi (Doküman sekmesi). Telefonda yine yerel IP'yi yaz (ör. http://192.168.1.42:8000).
EXPO_PUBLIC_RAG_URL=http://localhost:8000
